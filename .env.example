# Supabase project URL. Safe to expose in the browser.
VITE_SUPABASE_URL=

# Supabase anon/public key. Safe to expose; RLS and database functions enforce access.
VITE_SUPABASE_ANON_KEY=

# Never add a service-role key here. It bypasses RLS and must stay in CI only.

# Test-only variables used by tests/setup/db.ts. Put them in .env.test.local.
# Never use production keys for tests.
# TEST_SUPABASE_URL=
# TEST_SUPABASE_ANON_KEY=
# TEST_SUPABASE_SERVICE_ROLE_KEY=

# One-time setup only. Put these in .env.setup.local (gitignored).
# See docs/setup.md.
# SUPABASE_DB_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# JJA_001_PASSWORD=
# JJA_002_PASSWORD=
